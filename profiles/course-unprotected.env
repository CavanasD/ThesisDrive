# Course attack-stage profile: isolated Core simulations on, WAF off.
# Extended gateway exercises (SSRF/JWT/CORS/Log4Shell) stay disabled because
# they are outside the nine assigned tasks.
LAB_MODE=true
CFMS_VULN_SQLI_ENABLED=true
CFMS_VULN_RCE_ENABLED=true
CFMS_VULN_AUTH_BYPASS_ENABLED=true
CFMS_VULN_PATH_TRAVERSAL_ENABLED=true
CFMS_VULN_IDOR_ENABLED=true
VULN_SSRF_ENABLED=false
VULN_JWT_ALG_NONE_ENABLED=false
VULN_CORS_ENABLED=false
VULN_LOG4SHELL_ENABLED=false
WAF_SQLI_ENABLED=false
WAF_XSS_ENABLED=false
WAF_PATH_TRAVERSAL_ENABLED=false
WAF_CMD_INJECTION_ENABLED=false
WAF_FILE_TYPE_ENABLED=false
LAB_RCE_REAL=true

# ── Log4Shell 插拔开关 ──
# true → JVM 注入 -Dcom.sun.jndi.ldap.object.trustURLCodebase=true（真实 RCE）
# false/空 → 不注入，保持 JDK 21 默认（仅验证注入点，不能 RCE）
# 改完须重建：docker compose ... up -d --no-deps --force-recreate security-gateway
# 或直接用：scripts/log4shell_switch.sh {status|on|off} [--recreate]
LOG4SHELL_TRUST_CODEBASE=false
