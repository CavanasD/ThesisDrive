# ── 行尾统一 ──────────────────────────────────────────────
# 仓库内一律使用 LF。Windows 检出时由 Git 自动处理，
# 避免编辑器把整个文件重写成 CRLF 污染 diff（曾导致 App.vue
# 出现 2468 行虚假改动，实际只有 43 行）。
* text=auto eol=lf

# 明确二进制，禁止行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.class binary
*.woff binary
*.woff2 binary
*.ttf binary

# 脚本类强制 LF（容器内执行，CRLF 会导致 shebang 失效）
*.sh text eol=lf
*.py  text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Windows 侧脚本保留 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 前端构建产物不计入语言统计
thesis_frontend/dist/** linguist-generated=true
transfer-data-plane/build/** linguist-generated=true
